<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup>
  <OutputType>WinExe</OutputType>
  <TargetFramework>net10.0-windows</TargetFramework>
  <UseWPF>true</UseWPF>
  <EnableWindowsTargeting>true</EnableWindowsTargeting>
  <Nullable>enable</Nullable>
  <ImplicitUsings>enable</ImplicitUsings>
  <AssemblyName>OTSSystemSanitizer</AssemblyName>
  <RootNamespace>OTSSystemSanitizer.Desktop</RootNamespace>
  <ApplicationIcon>Assets\OTSSystemSanitizer.ico</ApplicationIcon>
  <Company>Ohana Tech Solutions</Company>
  <Product>OTS System Sanitizer</Product>
  <Description>Windows Anti-Malware: Search and Destroy</Description>
  <Version>0.4.0</Version>
 </PropertyGroup>
 <ItemGroup>
  <ProjectReference Include="..\OTSSystemSanitizer.Core\OTSSystemSanitizer.Core.csproj"/>
  <!-- Header artwork is a WPF resource; the .ico is also the Windows exe/installer icon. -->
  <Resource Include="Assets\OTSSystemSanitizer.png"/>
  <Resource Include="Assets\OTSSystemSanitizer.ico"/>
 </ItemGroup>
</Project>
