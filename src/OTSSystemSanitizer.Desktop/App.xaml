<Application x:Class="OTSSystemSanitizer.Desktop.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
 <Application.Resources>
  <!-- Steel blue / slate design system. No external UI packages required. -->
  <SolidColorBrush x:Key="WindowSurface" Color="#0F172A"/>
  <SolidColorBrush x:Key="PanelBrush" Color="#1E293B"/>
  <SolidColorBrush x:Key="SurfaceRaised" Color="#24405E"/>
  <SolidColorBrush x:Key="SteelBlue" Color="#34587C"/>
  <SolidColorBrush x:Key="AccentBlue" Color="#4E79A7"/>
  <SolidColorBrush x:Key="IceBlue" Color="#8BA8CD"/>
  <SolidColorBrush x:Key="ForegroundBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="MutedForeground" Color="#A9BCD5"/>
  <SolidColorBrush x:Key="Hairline" Color="#324257"/>
  <LinearGradientBrush x:Key="GlassSurface" StartPoint="0,0" EndPoint="1,1">
   <GradientStop Color="#263951" Offset="0"/><GradientStop Color="#19283E" Offset="1"/>
  </LinearGradientBrush>

  <Style TargetType="{x:Type Window}">
   <Setter Property="FontFamily" Value="Segoe UI"/>
   <Setter Property="Background" Value="#0F172A"/>
   <Setter Property="Foreground" Value="#FFFFFF"/>
   <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
   <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
   <Setter Property="UseLayoutRounding" Value="True"/>
   <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <Style x:Key="GlassCard" TargetType="{x:Type Border}">
   <Setter Property="Background" Value="{StaticResource GlassSurface}"/>
   <Setter Property="BorderBrush" Value="#344863"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="12"/>
   <Setter Property="Padding" Value="19"/>
   <Setter Property="Effect">
    <Setter.Value><DropShadowEffect Color="#070D19" BlurRadius="20" ShadowDepth="4" Opacity="0.35"/></Setter.Value>
   </Setter>
  </Style>

  <Style TargetType="{x:Type Button}">
   <Setter Property="Foreground" Value="#FFFFFF"/>
   <Setter Property="Background" Value="#34587C"/>
   <Setter Property="BorderBrush" Value="#4E79A7"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="16,10"/>
   <Setter Property="Margin" Value="0,0,9,0"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="MinHeight" Value="36"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="{x:Type Button}">
     <Border x:Name="ButtonChrome" Background="{TemplateBinding Background}"
       BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
       Padding="{TemplateBinding Padding}" CornerRadius="10" SnapsToDevicePixels="True">
      <ContentPresenter ContentSource="Content" RecognizesAccessKey="True"
       HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
       <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#8BA8CD"/>
       <Setter TargetName="ButtonChrome" Property="Effect">
        <Setter.Value><DropShadowEffect Color="#4E79A7" BlurRadius="15" Opacity="0.35" ShadowDepth="0"/></Setter.Value>
       </Setter>
      </Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonChrome" Property="Opacity" Value="0.78"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True">
       <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#E1F0FF"/>
       <Setter TargetName="ButtonChrome" Property="BorderThickness" Value="2"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonChrome" Property="Opacity" Value="0.38"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>

  <Style TargetType="{x:Type TextBox}">
   <Setter Property="Background" Value="#142339"/>
   <Setter Property="Foreground" Value="#F5F9FF"/>
   <Setter Property="CaretBrush" Value="#8BA8CD"/>
   <Setter Property="BorderBrush" Value="#34587C"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="12,9"/>
   <Setter Property="SelectionBrush" Value="#4E79A7"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="{x:Type TextBox}">
     <Border x:Name="InputChrome" Background="{TemplateBinding Background}"
      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
      CornerRadius="10" Padding="{TemplateBinding Padding}">
      <ScrollViewer x:Name="PART_ContentHost"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
       <Setter TargetName="InputChrome" Property="BorderBrush" Value="#8BA8CD"/>
       <Setter TargetName="InputChrome" Property="Effect">
        <Setter.Value><DropShadowEffect Color="#34587C" BlurRadius="12" ShadowDepth="0" Opacity="0.6"/></Setter.Value>
       </Setter>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="InputChrome" Property="Opacity" Value="0.45"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>

  <Style TargetType="{x:Type CheckBox}">
   <Setter Property="Foreground" Value="#ECF4FF"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="{x:Type CheckBox}">
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Border x:Name="CheckFrame" Background="#152237" BorderBrush="#567495"
       BorderThickness="1" CornerRadius="4" Width="18" Height="18" VerticalAlignment="Center">
       <Path x:Name="CheckMark" Data="M 3,9 L 7,13 L 15,4"
        Stroke="White" StrokeThickness="2" StrokeLineJoin="Round"
        Visibility="Collapsed" Stretch="None"/>
      </Border>
      <ContentPresenter ContentSource="Content" Margin="8,0,0,0" VerticalAlignment="Center"
        RecognizesAccessKey="True"/>
     </StackPanel>
     <ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True">
       <Setter TargetName="CheckFrame" Property="Background" Value="#4E79A7"/>
       <Setter TargetName="CheckFrame" Property="BorderBrush" Value="#8BA8CD"/>
       <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
      </Trigger>
      <Trigger Property="IsChecked" Value="{x:Null}">
       <Setter TargetName="CheckFrame" Property="Background" Value="#34587C"/>
       <Setter TargetName="CheckFrame" Property="BorderBrush" Value="#8BA8CD"/>
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckFrame" Property="BorderBrush" Value="#DCE9FF"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>

  <Style TargetType="{x:Type ListView}">
   <Setter Property="Background" Value="#142239"/>
   <Setter Property="Foreground" Value="#F0F6FF"/>
   <Setter Property="BorderBrush" Value="#30435C"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
   <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
  </Style>
  <Style TargetType="{x:Type ListViewItem}">
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Foreground" Value="#F0F6FF"/>
   <Setter Property="Padding" Value="9,8"/>
   <Setter Property="Margin" Value="0,0,0,1"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="{x:Type ListViewItem}">
     <Border x:Name="RowChrome" Background="{TemplateBinding Background}"
      BorderBrush="#27394F" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
      <GridViewRowPresenter Content="{TemplateBinding Content}" Columns="{Binding Path=View.Columns, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowChrome" Property="Background" Value="#223751"/></Trigger>
      <Trigger Property="IsSelected" Value="True">
       <Setter TargetName="RowChrome" Property="Background" Value="#274665"/>
       <Setter TargetName="RowChrome" Property="BorderBrush" Value="#4E79A7"/>
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="{x:Type GridViewColumnHeader}">
   <Setter Property="Background" Value="#1D3048"/>
   <Setter Property="Foreground" Value="#AFC7E3"/>
   <Setter Property="BorderBrush" Value="#31455E"/>
   <Setter Property="BorderThickness" Value="0,0,1,1"/>
   <Setter Property="Padding" Value="10,12"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <!-- Persistent left navigation; every tab remains fully functional. -->
  <Style TargetType="{x:Type TabControl}">
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="TabStripPlacement" Value="Left"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="{x:Type TabControl}">
     <Grid KeyboardNavigation.TabNavigation="Local">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="198"/><ColumnDefinition Width="15"/><ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#17253A" BorderBrush="#30435C"
       BorderThickness="1" CornerRadius="12" Padding="11,17">
       <StackPanel>
        <TextBlock Text="WORKSPACE" Foreground="#8BA8CD" Margin="14,0,0,15"
         FontWeight="SemiBold" FontSize="11"/>
        <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1"/>
        <Border Height="1" Background="#30435C" Margin="8,20,8,15"/>
        <TextBlock Text="OFFLINE-FIRST" FontSize="10" Margin="14,0,0,7" Foreground="#8BA8CD"/>
        <TextBlock Text="Local Windows security tools" FontSize="11" Margin="14,0,0,0"
         Foreground="#A9BCD5" TextWrapping="Wrap"/>
       </StackPanel>
      </Border>
      <Border Grid.Column="2" Background="#17253A" BorderBrush="#30435C"
        BorderThickness="1" CornerRadius="12" Padding="11">
       <ContentPresenter ContentSource="SelectedContent" KeyboardNavigation.TabIndex="2"/>
      </Border>
     </Grid>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="{x:Type TabItem}">
   <Setter Property="Foreground" Value="#BED0E5"/>
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Margin" Value="0,0,0,6"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="{x:Type TabItem}">
     <Border x:Name="NavChrome" Background="Transparent"
       BorderBrush="Transparent" BorderThickness="1" CornerRadius="10"
       Padding="15,13" Cursor="Hand">
      <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
       <Setter TargetName="NavChrome" Property="Background" Value="#213954"/>
       <Setter Property="Foreground" Value="#FFFFFF"/>
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
       <Setter TargetName="NavChrome" Property="Background" Value="#24405E"/>
       <Setter TargetName="NavChrome" Property="BorderBrush" Value="#4E79A7"/>
       <Setter TargetName="NavChrome" Property="Effect">
        <Setter.Value><DropShadowEffect Color="#4E79A7" BlurRadius="12" ShadowDepth="0" Opacity="0.24"/></Setter.Value>
       </Setter>
       <Setter Property="Foreground" Value="#FFFFFF"/>
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
 </Application.Resources>
</Application>