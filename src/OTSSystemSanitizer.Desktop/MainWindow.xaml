<Window x:Class="OTSSystemSanitizer.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="OTS System Sanitizer — Search and Destroy"
 Icon="Assets/OTSSystemSanitizer.ico"
 Height="780" Width="1280" MinHeight="540" MinWidth="760"
 WindowStartupLocation="CenterScreen">
 <Grid Margin="20">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="15"/>
   <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <Border Grid.Row="0" Style="{StaticResource GlassCard}" Padding="15,11">
   <DockPanel LastChildFill="True">
    <Border DockPanel.Dock="Left" Background="#132239" BorderBrush="#34587C"
       BorderThickness="1" CornerRadius="12" Width="60" Height="60" Margin="0,0,16,0">
     <Image Source="pack://application:,,,/Assets/OTSSystemSanitizer.png"
       Width="54" Height="54" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
    </Border>
    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
     <TextBlock Text="OTS SYSTEM SANITIZER" FontWeight="Bold" FontSize="21" Foreground="#FFFFFF"/>
     <TextBlock Text="Windows Anti-Malware: Search and Destroy"
       Foreground="#8BA8CD" FontSize="12" Margin="0,5,0,0"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Right" Width="250" VerticalAlignment="Center" Margin="22,0,4,0">
     <TextBlock Text="FILTER THREAT FINDINGS" FontSize="10" Foreground="#8BA8CD"
       FontWeight="SemiBold" Margin="3,0,0,5"/>
     <TextBox x:Name="FindingSearchBox" Height="39" FontSize="12"
       ToolTip="Filter findings by name, source, path or evidence. This does not start a new search."
       TextChanged="FindingSearchBox_TextChanged"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Style="{StaticResource GlassCard}">
    <StackPanel>
     <TextBlock Text="FILES SEARCHED" Foreground="#8BA8CD" FontSize="11"/>
     <TextBlock x:Name="FilesCount" Text="0" FontWeight="Bold" FontSize="30" Margin="0,6,0,0"/>
    </StackPanel>
   </Border>
   <Border Grid.Column="2" Style="{StaticResource GlassCard}">
    <StackPanel>
     <TextBlock Text="FINDINGS FOR REVIEW" Foreground="#9CB5D1" FontSize="12"/>
     <TextBlock x:Name="FindingCount" Text="0" FontWeight="Bold" FontSize="30" Margin="0,6,0,0"/>
    </StackPanel>
   </Border>
   <Border Grid.Column="4" Style="{StaticResource GlassCard}">
    <StackPanel>
     <TextBlock Text="ELIGIBLE CLEANUP" Foreground="#9CB5D1" FontSize="12"/>
     <TextBlock x:Name="SpaceCount" Text="0 MB" FontWeight="Bold" FontSize="30" Margin="0,6,0,0"/>
    </StackPanel>
   </Border>
  </Grid>
  <Border Grid.Row="4" Style="{StaticResource GlassCard}" Padding="16">
   <StackPanel>
    <DockPanel Margin="0,0,0,12">
     <TextBlock Text="THREAT SEARCH ENGINE" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF"/>
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
      <Border Background="#24405E" BorderBrush="#34587C" BorderThickness="1" CornerRadius="10" Padding="10,4" Margin="8,0,0,0">
       <TextBlock Text="LOCAL" FontSize="10" FontWeight="SemiBold" Foreground="#CBE1FB"/>
      </Border>
      <Border Background="#24405E" BorderBrush="#34587C" BorderThickness="1" CornerRadius="10" Padding="10,4" Margin="8,0,0,0">
       <TextBlock Text="EVIDENCE FIRST" FontSize="10" Foreground="#CBE1FB" FontWeight="SemiBold"/>
      </Border>
     </StackPanel>
    </DockPanel>
    <WrapPanel Margin="0,0,0,14">
     <Button x:Name="QuickButton" Click="Quick_Click" Content="Quick Search" FontSize="14" Padding="23,11"/>
     <Button x:Name="DeepButton" Click="Deep_Click" Content="Deep Search" Background="#24405E"/>
     <Button x:Name="CancelButton" Click="Cancel_Click" Content="Stop Search" Background="#754453" IsEnabled="False"/>
     <Button x:Name="CleanAndSecureButton" Click="CleanAndSecure_Click" Content="Clean &amp; Secure" Background="#34587C"/>
    </WrapPanel>
    <DockPanel LastChildFill="True">
     <TextBlock x:Name="ElapsedSearchTime" Text="Search duration: 00:00:00" DockPanel.Dock="Right" Foreground="#9CCBFF" FontWeight="SemiBold" Margin="16,0,0,0"/>
     <TextBlock x:Name="ScanStatus" Text="Ready. No search has been completed." Foreground="#C4D2E7" TextWrapping="Wrap"/>
    </DockPanel>
    <ProgressBar x:Name="ScanBar" Height="8" Margin="0,12,0,0"
      Background="#0F172A" Foreground="#4E79A7" IsIndeterminate="False"/>
    <TextBlock x:Name="CoverageStatus" Text="Local findings are unverified heuristics. Microsoft Defender provides antivirus coverage when available; this app is not a standalone antivirus."
      Foreground="#8CA9C9" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="12"/>
   </StackPanel>
  </Border>
  <TabControl x:Name="MainTabs" Grid.Row="6" TabStripPlacement="Left">
   <TabItem Header="⌕  Threat Review" IsSelected="True">
    <Grid Margin="8">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
     <DockPanel Margin="4,8,0,10" LastChildFill="False">
      <TextBlock Text="Indicators are not proof of malware; only eligible user files can be quarantined."
        Foreground="#A8BAD0" VerticalAlignment="Center"/>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
       <CheckBox x:Name="SelectAllThreatsCheck" Content="Select all" IsEnabled="False"
        Foreground="#E0EAFA" VerticalAlignment="Center" Margin="14,0,9,0"
        Click="SelectAllThreats_Click" ToolTip="Select all eligible files; historical Defender records and protected paths cannot be moved."/>
       <TextBlock x:Name="ThreatSelection" Text="0 selected" VerticalAlignment="Center" Foreground="#ACBED4"/>
       <Button x:Name="QuarantineButton" Content="Quarantine &amp; investigate checked" Click="Quarantine_Click"
        Background="#79513B" Margin="14,0,0,0" IsEnabled="False"/>
      </StackPanel>
     </DockPanel>
     </ScrollViewer>
     <ListView Grid.Row="1" x:Name="ThreatList" SelectionMode="Extended">
      <ListView.View><GridView>
       <GridViewColumn Header="Select" Width="65"><GridViewColumn.CellTemplate><DataTemplate>
        <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          IsEnabled="{Binding CanQuarantine}" ToolTip="{Binding SelectionHint}"/>
       </DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
       <GridViewColumn Header="Severity" Width="88" DisplayMemberBinding="{Binding Level}"/>
       <GridViewColumn Header="Finding" Width="180" DisplayMemberBinding="{Binding Title}"/>
       <GridViewColumn Header="Source" Width="175" DisplayMemberBinding="{Binding Source}"/>
       <GridViewColumn Header="Path / location" Width="330" DisplayMemberBinding="{Binding Path}"/>
       <GridViewColumn Header="Evidence" Width="590" DisplayMemberBinding="{Binding Evidence}"/>
      </GridView></ListView.View>
     </ListView>
    </Grid>
   </TabItem>
   <TabItem Header="▤  Space Recovery">
    <Grid Margin="8">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
     <DockPanel Margin="4,8,0,10">
      <StackPanel Orientation="Horizontal">
       <Button Content="Analyze storage" Click="Analyze_Click"/>
       <CheckBox x:Name="BrowserCacheCheck" Content="Include browser cache (opt-in)"
        VerticalAlignment="Center" Foreground="#E0EAFA" Margin="4,0,16,0"/>
       <CheckBox x:Name="SelectAllCleanupCheck" Content="Select all" IsEnabled="False"
        VerticalAlignment="Center" Foreground="#E0EAFA" Margin="0,0,16,0"
        Click="SelectAllCleanup_Click"
        ToolTip="Select or clear all currently listed cleanup files. Permanent destruction still requires confirmation."/>
       <TextBlock x:Name="CleanupSelection" Text="" Foreground="#ACBED4" VerticalAlignment="Center"/>
      </StackPanel>
      <Button DockPanel.Dock="Right" Content="Destroy checked cleanup files" Click="DeleteChecked_Click"
        Background="#754453" HorizontalAlignment="Right" Margin="10,0,0,0"/>
     </DockPanel>
     </ScrollViewer>
     <ListView Grid.Row="1" x:Name="CleanupList">
      <ListView.View><GridView>
       <GridViewColumn Header="Destroy" Width="68">
        <GridViewColumn.CellTemplate><DataTemplate>
         <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </DataTemplate></GridViewColumn.CellTemplate>
       </GridViewColumn>
       <GridViewColumn Header="Category" Width="175" DisplayMemberBinding="{Binding Category}"/>
       <GridViewColumn Header="Size" Width="110" DisplayMemberBinding="{Binding Size}"/>
       <GridViewColumn Header="File path" Width="730" DisplayMemberBinding="{Binding Path}"/>
      </GridView></ListView.View>
     </ListView>
    </Grid>
   </TabItem>


   <TabItem Header="▦  Installed Apps">
    <Grid Margin="8">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
     <DockPanel Margin="4,8,0,10">
      <StackPanel Orientation="Horizontal">
       <Button Click="RefreshApps_Click" Content="Inspect installed apps"/>
       <Button Click="OpenApps_Click" Content="Open Windows Uninstall" Background="#2C557B"/>
      </StackPanel>
      <TextBlock DockPanel.Dock="Right" Text="Stale-location hints are informational; removal uses Windows Settings."
       Foreground="#A8BAD0" VerticalAlignment="Center"/>
     </DockPanel>
     </ScrollViewer>
     <ListView x:Name="InstalledAppList" Grid.Row="1">
      <ListView.View><GridView>
       <GridViewColumn Header="Application" Width="270" DisplayMemberBinding="{Binding Name}"/>
       <GridViewColumn Header="Publisher" Width="170" DisplayMemberBinding="{Binding Publisher}"/>
       <GridViewColumn Header="Version" Width="110" DisplayMemberBinding="{Binding Version}"/>
       <GridViewColumn Header="Reported size" Width="115" DisplayMemberBinding="{Binding Size}"/>
       <GridViewColumn Header="Status" Width="260" DisplayMemberBinding="{Binding Status}"/>
       <GridViewColumn Header="Install folder" Width="420" DisplayMemberBinding="{Binding InstallLocation}"/>
      </GridView></ListView.View>
     </ListView>
    </Grid>
   </TabItem>
   <TabItem Header="◇  Quarantine">
    <Grid Margin="8">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="195"/></Grid.RowDefinitions>
     <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
     <DockPanel Margin="4,8,0,10" LastChildFill="False">
      <TextBlock Text="Review quarantined evidence before destroying or restoring." Foreground="#ACBED4" VerticalAlignment="Center"/>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
       <Button x:Name="InvestigateButton" Content="Investigate selected" Click="Investigate_Click" Background="#34587C"/>
       <Button x:Name="DestroyButton" Content="Destroy reviewed file" Click="Destroy_Click"
        Background="#754453" Margin="8,0,0,0" IsEnabled="False"/>
       <Button Content="Restore selected file" Click="Restore_Click" Background="#2A6B70" Margin="8,0,0,0"/>
      </StackPanel>
     </DockPanel>
     </ScrollViewer>
     <ListView Grid.Row="1" x:Name="QuarantineList" SelectionChanged="QuarantineList_SelectionChanged">
      <ListView.View><GridView>
       <GridViewColumn Header="Date" Width="170" DisplayMemberBinding="{Binding QuarantinedAt}"/>
       <GridViewColumn Header="Original path" Width="630" DisplayMemberBinding="{Binding OriginalPath}"/>
       <GridViewColumn Header="SHA-256" Width="470" DisplayMemberBinding="{Binding Sha256}"/>
      </GridView></ListView.View>
     </ListView>
     <TextBox Grid.Row="2" x:Name="InvestigationDetails" IsReadOnly="True" 
      Text="Select a quarantined file, then choose Investigate selected to review the evidence."
      Background="#142239" Foreground="#D7E6F9" BorderBrush="#34587C"
      Padding="10" Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap"
      VerticalScrollBarVisibility="Auto"/>
    </Grid>
   </TabItem>
   <TabItem Header="◷  Activity">
    <Grid Margin="12">
     <TextBox x:Name="ActivityLog" Background="#111D31" Foreground="#D7E6F9" BorderThickness="0"
      IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
      FontFamily="Consolas" FontSize="12" />
    </Grid>
   </TabItem>
  </TabControl>
  <DockPanel Grid.Row="7" Margin="2,12,0,0">
   <TextBlock Text="Ohana Tech Solutions" FontSize="11" Foreground="#8BA8CD" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
   <TextBlock Text="Windows 10/11 x64  •  Offline-first  •  Destruction requires review  •  v0.4"
    FontSize="11" Foreground="#839AB4"/>
  </DockPanel>
 </Grid>
</Window>
