<Window x:Class="OTSSystemSanitizer.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="OTS System Sanitizer — Security and Storage" Height="800" Width="1240"
 MinHeight="680" MinWidth="1000" WindowStartupLocation="CenterScreen">
 <Grid Margin="28">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="20"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="18"/>
   <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <DockPanel Grid.Row="0" LastChildFill="True">
   <Border Background="#214F89" CornerRadius="10" Width="56" Height="56" DockPanel.Dock="Left" Margin="0,0,18,0">
    <TextBlock Text="⬡" FontSize="37" Foreground="#9CCBFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
   </Border>
   <StackPanel>
    <TextBlock Text="OTS SYSTEM SANITIZER" FontWeight="Bold" FontSize="27"/>
    <TextBlock Text="Windows security inspection and safe space recovery" Foreground="#A3B8D3" FontSize="13" Margin="0,5,0,0"/>
   </StackPanel>
  </DockPanel>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="#17253B" CornerRadius="10" Padding="18">
    <StackPanel>
     <TextBlock Text="FILES INSPECTED" Foreground="#9CB5D1" FontSize="12"/>
     <TextBlock x:Name="FilesCount" Text="0" FontWeight="SemiBold" FontSize="28" Margin="0,6,0,0"/>
    </StackPanel>
   </Border>
   <Border Grid.Column="2" Background="#17253B" CornerRadius="10" Padding="18">
    <StackPanel>
     <TextBlock Text="FINDINGS FOR REVIEW" Foreground="#9CB5D1" FontSize="12"/>
     <TextBlock x:Name="FindingCount" Text="0" FontWeight="SemiBold" FontSize="28" Margin="0,6,0,0"/>
    </StackPanel>
   </Border>
   <Border Grid.Column="4" Background="#17253B" CornerRadius="10" Padding="18">
    <StackPanel>
     <TextBlock Text="ELIGIBLE CLEANUP" Foreground="#9CB5D1" FontSize="12"/>
     <TextBlock x:Name="SpaceCount" Text="0 MB" FontWeight="SemiBold" FontSize="28" Margin="0,6,0,0"/>
    </StackPanel>
   </Border>
  </Grid>
  <Border Grid.Row="4" Background="#17253B" CornerRadius="10" Padding="18">
   <StackPanel>
    <WrapPanel Margin="0,0,0,14">
     <Button x:Name="QuickButton" Click="Quick_Click" Content="Quick Scan"/>
     <Button x:Name="DeepButton" Click="Deep_Click" Content="Deep Scan" Background="#2C557B"/>
     <Button x:Name="CancelButton" Click="Cancel_Click" Content="Cancel" Background="#754453" IsEnabled="False"/>
     <Button x:Name="CleanAndSecureButton" Click="CleanAndSecure_Click" Content="Clean &amp; Secure" Background="#137D80"/>
    </WrapPanel>
    <TextBlock x:Name="ScanStatus" Text="Ready. No scan has been completed." Foreground="#C4D2E7" TextWrapping="Wrap"/>
    <ProgressBar x:Name="ScanBar" Height="8" Margin="0,12,0,0"
      Background="#0E192B" Foreground="#5FA0F5" IsIndeterminate="False"/>
    <TextBlock x:Name="CoverageStatus" Text="OTS System Sanitizer uses local heuristics and Microsoft Defender when available. It is not a standalone antivirus."
      Foreground="#8CA9C9" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="12"/>
   </StackPanel>
  </Border>
  <TabControl x:Name="MainTabs" Grid.Row="6">
   <TabItem Header="Threat detection" IsSelected="True">
    <Grid Margin="8">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel Margin="4,8,0,10">
      <TextBlock Text="Heuristic findings are not proof of infection. Review evidence before action."
        Foreground="#A8BAD0" VerticalAlignment="Center"/>
      <Button DockPanel.Dock="Right" Content="Quarantine selected file" HorizontalAlignment="Right"
        Click="Quarantine_Click" Background="#79513B" Margin="12,0,0,0"/>
     </DockPanel>
     <ListView Grid.Row="1" x:Name="ThreatList" SelectionMode="Single">
      <ListView.View>
       <GridView>
        <GridViewColumn Header="Severity" Width="88" DisplayMemberBinding="{Binding Level}"/>
        <GridViewColumn Header="Finding" Width="180" DisplayMemberBinding="{Binding Title}"/>
        <GridViewColumn Header="Source" Width="175" DisplayMemberBinding="{Binding Source}"/>
        <GridViewColumn Header="Path / location" Width="330" DisplayMemberBinding="{Binding Path}"/>
        <GridViewColumn Header="Evidence" Width="590" DisplayMemberBinding="{Binding Evidence}"/>
       </GridView>
      </ListView.View>
     </ListView>
    </Grid>
   </TabItem>
   <TabItem Header="Space recovery">
    <Grid Margin="8">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel Margin="4,8,0,10">
      <StackPanel Orientation="Horizontal">
       <Button Content="Analyze storage" Click="Analyze_Click"/>
       <CheckBox x:Name="BrowserCacheCheck" Content="Include browser cache (opt-in)"
        VerticalAlignment="Center" Foreground="#E0EAFA" Margin="4,0,16,0"/>
       <CheckBox x:Name="SelectAllCleanupCheck" Content="Select all" IsEnabled="False"
        VerticalAlignment="Center" Foreground="#E0EAFA" Margin="0,0,16,0"
        Click="SelectAllCleanup_Click"
        ToolTip="Select or clear all currently listed cleanup files. Permanent deletion still requires confirmation."/>
       <TextBlock x:Name="CleanupSelection" Text="" Foreground="#ACBED4" VerticalAlignment="Center"/>
      </StackPanel>
      <Button DockPanel.Dock="Right" Content="Delete checked files" Click="DeleteChecked_Click"
        Background="#754453" HorizontalAlignment="Right" Margin="10,0,0,0"/>
     </DockPanel>
     <ListView Grid.Row="1" x:Name="CleanupList">
      <ListView.View><GridView>
       <GridViewColumn Header="Delete" Width="68">
        <GridViewColumn.CellTemplate><DataTemplate>
         <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </DataTemplate></GridViewColumn.CellTemplate>
       </GridViewColumn>
       <GridViewColumn Header="Category" Width="175" DisplayMemberBinding="{Binding Category}"/>
       <GridViewColumn Header="Size" Width="110" DisplayMemberBinding="{Binding Size}"/>
       <GridViewColumn Header="File path" Width="730" DisplayMemberBinding="{Binding Path}"/>
      </GridView></ListView.View>
     </ListView>
    </Grid>
   </TabItem>


   <TabItem Header="GitHub repositories">
    <Grid Margin="8">
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="130"/>
     </Grid.RowDefinitions>
     <TextBlock Grid.Row="0" Foreground="#ACBED4" Margin="4,5,0,10" TextWrapping="Wrap"
      Text="Read-only GitHub access. Add a fine-grained personal access token for each account (Metadata: read; Contents: read). Credentials are encrypted for your Windows user; no browser sign-in required."/>
     <WrapPanel Grid.Row="1" Margin="4,0,0,8" VerticalAlignment="Center">
      <TextBlock Text="GitHub token:" VerticalAlignment="Center" Foreground="#E0EAFA" Margin="0,0,10,0"/>
      <PasswordBox x:Name="GitHubToken" Width="270" Height="33" VerticalContentAlignment="Center"
       Background="#1C2D47" Foreground="#F0F5FF" BorderBrush="#35516E" Margin="0,0,10,0"/>
      <Button x:Name="GitHubConnectButton" Content="Connect account" Click="GitHubConnect_Click"/>
      <Button x:Name="GitHubRemoveButton" Content="Disconnect selected" Click="GitHubRemove_Click" Background="#754453"/>
      <Button x:Name="GitHubRefreshButton" Content="Refresh repositories" Click="GitHubRefresh_Click" Background="#2C557B"/>
     </WrapPanel>
     <DockPanel Grid.Row="2" Margin="4,0,0,8">
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
       <TextBlock Text="Account:" VerticalAlignment="Center" Foreground="#E0EAFA" Margin="0,0,10,0"/>
       <ComboBox x:Name="GitHubAccountSelector" Width="185" Height="29"
        SelectionChanged="GitHubAccountSelector_SelectionChanged"/>
      </StackPanel>
      <TextBlock x:Name="GitHubStatus" Text="No accounts connected." Foreground="#9CB5D1"
       TextWrapping="Wrap" VerticalAlignment="Center" Margin="16,0,0,0"/>
     </DockPanel>
     <Grid Grid.Row="3">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid Grid.Column="0">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <DockPanel Margin="0,0,0,6">
        <TextBlock Text="REPOSITORIES" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <Button DockPanel.Dock="Right" x:Name="GitHubOpenRepoButton" Content="Browse selected repository"
         Click="GitHubOpenRepo_Click" HorizontalAlignment="Right" Background="#285DAD"/>
       </DockPanel>
       <ListView x:Name="GitHubRepoList" Grid.Row="1">
        <ListView.View><GridView>
         <GridViewColumn Header="Account" Width="110" DisplayMemberBinding="{Binding Account}"/>
         <GridViewColumn Header="Repository" Width="260" DisplayMemberBinding="{Binding FullName}"/>
         <GridViewColumn Header="Visibility" Width="80" DisplayMemberBinding="{Binding Visibility}"/>
        </GridView></ListView.View>
       </ListView>
      </Grid>
      <Grid Grid.Column="2">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <DockPanel Margin="0,0,0,6">
        <TextBlock Text="REPOSITORY FILES" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
         <Button x:Name="GitHubUpButton" Content="Up folder" Click="GitHubUp_Click" Background="#2C557B"/>
         <Button x:Name="GitHubOpenItemButton" Content="Open selected" Click="GitHubOpenItem_Click"/>
        </StackPanel>
       </DockPanel>
       <ListView Grid.Row="1" x:Name="GitHubContentsList">
        <ListView.View><GridView>
         <GridViewColumn Header="Name" Width="285" DisplayMemberBinding="{Binding Name}"/>
         <GridViewColumn Header="Type" Width="66" DisplayMemberBinding="{Binding Kind}"/>
         <GridViewColumn Header="Size" Width="90" DisplayMemberBinding="{Binding SizeLabel}"/>
        </GridView></ListView.View>
       </ListView>
      </Grid>
     </Grid>
     <TextBlock Grid.Row="4" x:Name="GitHubFilePath" Text="FILE PREVIEW (READ ONLY)" FontWeight="SemiBold"
      Margin="2,10,0,6" TextTrimming="CharacterEllipsis"/>
     <TextBox Grid.Row="5" x:Name="GitHubFilePreview" IsReadOnly="True" FontFamily="Consolas"
      FontSize="12" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
      HorizontalScrollBarVisibility="Auto" Background="#111D31" Foreground="#D7E6F9"
      BorderBrush="#35516E" Padding="8"/>
    </Grid>
   </TabItem>
   <TabItem Header="Installed applications">
    <Grid Margin="8">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel Margin="4,8,0,10">
      <StackPanel Orientation="Horizontal">
       <Button Click="RefreshApps_Click" Content="Inspect installed apps"/>
       <Button Click="OpenApps_Click" Content="Open Windows Uninstall" Background="#2C557B"/>
      </StackPanel>
      <TextBlock DockPanel.Dock="Right" Text="Stale-location hints are informational; removal uses Windows Settings."
       Foreground="#A8BAD0" VerticalAlignment="Center"/>
     </DockPanel>
     <ListView x:Name="InstalledAppList" Grid.Row="1">
      <ListView.View><GridView>
       <GridViewColumn Header="Application" Width="270" DisplayMemberBinding="{Binding Name}"/>
       <GridViewColumn Header="Publisher" Width="170" DisplayMemberBinding="{Binding Publisher}"/>
       <GridViewColumn Header="Version" Width="110" DisplayMemberBinding="{Binding Version}"/>
       <GridViewColumn Header="Reported size" Width="115" DisplayMemberBinding="{Binding Size}"/>
       <GridViewColumn Header="Status" Width="260" DisplayMemberBinding="{Binding Status}"/>
       <GridViewColumn Header="Install folder" Width="420" DisplayMemberBinding="{Binding InstallLocation}"/>
      </GridView></ListView.View>
     </ListView>
    </Grid>
   </TabItem>
   <TabItem Header="Quarantine">
    <Grid Margin="8">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel Margin="4,8,0,10">
      <TextBlock Text="User-scoped AES-256-GCM encrypted quarantine with Windows DPAPI. Not kernel-enforced."
        Foreground="#ACBED4" VerticalAlignment="Center"/>
      <Button Content="Restore selected file" DockPanel.Dock="Right" Click="Restore_Click"
       Background="#2A6B70" Margin="12,0,0,0"/>
     </DockPanel>
     <ListView Grid.Row="1" x:Name="QuarantineList">
      <ListView.View><GridView>
       <GridViewColumn Header="Date" Width="170" DisplayMemberBinding="{Binding QuarantinedAt}"/>
       <GridViewColumn Header="Original path" Width="630" DisplayMemberBinding="{Binding OriginalPath}"/>
       <GridViewColumn Header="SHA-256" Width="470" DisplayMemberBinding="{Binding Sha256}"/>
      </GridView></ListView.View>
     </ListView>
    </Grid>
   </TabItem>
   <TabItem Header="Activity">
    <Grid Margin="12">
     <TextBox x:Name="ActivityLog" Background="#111D31" Foreground="#D7E6F9" BorderThickness="0"
      IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
      FontFamily="Consolas" FontSize="12" />
    </Grid>
   </TabItem>
  </TabControl>
  <DockPanel Grid.Row="7" Margin="2,12,0,0">
   <TextBlock Text="Ohana Tech Solutions" FontSize="11" Foreground="#839AB4" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
   <TextBlock Text="Windows 10/11 x64  •  Offline-first  •  No automatic deletion  •  v0.2"
    FontSize="11" Foreground="#839AB4"/>
  </DockPanel>
 </Grid>
</Window>
